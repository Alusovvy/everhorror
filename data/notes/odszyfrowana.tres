[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://script/data/note_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"odszyfrowana"
title = "Odszyfrowana wiadomość dziadka"
text = "Przesunięcie o siedem liter. Dziadek nikomu nie ufał, ale szyfry miał proste.\n\n„Jeśli to czytasz, klucz przetrwał zawał. Błękit nie bierze się ze skały. On rośnie z Nich. Każda tona, którą wywozimy na górę, to kawałek Ich snu. Nie schodźcie niżej, niż musicie. Ja zejdę, bo ktoś musi Ich zobaczyć, zanim Oni zobaczą nas.”"
