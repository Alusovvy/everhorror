[gd_resource type="Resource" script_class="NoteData" format=3]

[ext_resource type="Script" path="res://script/data/note_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"szyfr"
title = "Kartka z szyfrem dziadka"
text = "Leżała w jaskini za Starą sztolnią. Pismo dziadka, drobne i pochyłe.\n\nWŻSGC ŁKMŹA ĘTPRO\nBŃUFH ZYJŚD CEIOA\nŃRGŁT ĄPSWK MUŹYE\n\nNa dole jedno zdanie, którego nie zaszyfrował: „Nie idźcie za błękitem.”"
