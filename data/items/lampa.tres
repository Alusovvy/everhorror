[resource]
script = ExtResource("1_script")
id = &"lampa"
display_name = "Stara lampa przewodnika"
name_accusative = "starą lampę"
description = "Górnicza lampa oliwna, okopcona i pogięta, ze znakiem dziadka wybitym w denku. Na szkle wydrapano czternaście kresek. Ktoś zostawił ją przy twoim posłaniu, kiedy spałeś. Pali się równo i jakoś nie chce zgasnąć."
category = 4
heal = 0
sanity = 0
cures_fever = false
consumable = false
use_hours = 0
use_text = ""
