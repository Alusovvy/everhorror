display_name = "Worek z prowiantem"
description = "Płócienny worek zawiązany na supeł. W środku suchary, kawał słoniny i garść suszonych jabłek. Starczy na dzień, może dwa."

[node name="Interactable" type="Area3D" parent="Barrel2"]
script = ExtResource("10_inter")
display_name = "Beczka"
description = "Dębowa beczka okuta żelazem. Śmierdzi siarką i saletrą. Z lampą lepiej się do niej nie zbliżać."

