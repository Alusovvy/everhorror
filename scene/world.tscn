script = ExtResource("10_inter")
display_name = "Zwinięta notatka"
on_use_note = &"notatka_dowodcy"
description = "Pożółkła kartka zapisana drobnym, nerwowym pismem:

„Dzień czternasty. Im niżej schodzimy, tym jaśniej świeci błękit w ścianach. Ludzie gadają przez sen, ale nie swoimi głosami. Jutro schodzimy niżej.”

Przepisujesz to do notesu."
solid = false
padding = 0.12

